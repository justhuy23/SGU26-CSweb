<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NVBPlay</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/icons/favicon.png" />
</head>
<body class="font-sans antialiased bg-gray-50">
    <div id="wrapper" class="min-h-screen flex flex-col">
        <!-- HEADER TĨNH -->
        <header id="header" class="sticky top-0 z-40 bg-white shadow-sm">
            <!-- Bạn copy toàn bộ thẻ <header> từ dòng 206 đến 640 trong file PHP cũ dán vào đây -->
            <div class="bg-gray-900 text-white py-2 text-center text-sm">
                <a href="#">⚡ VỢT YONEX NANOFLARE 1000 GAME - RESTOCKED ⚡</a>
            </div>
            <div class="container mx-auto px-4 py-3 flex justify-between items-center border-b">
                <div class="flex items-center space-x-4">
                    <button class="menu-toggle md:hidden"><i class="fas fa-bars text-xl"></i></button>
                    <a href="/" class="text-2xl font-bold text-red-600">NVBPlay</a>
                </div>
                <!-- Giả lập thanh tìm kiếm -->
                <div class="hidden md:flex flex-1 max-w-md mx-4">
                    <input type="text" placeholder="Tìm kiếm sản phẩm..." class="w-full px-4 py-2 border rounded-full bg-gray-100">
                </div>
                <div class="flex items-center space-x-4">
                    <a href="#" class="text-gray-700 hover:text-red-600"><i class="fas fa-user text-xl"></i></a>
                    <a href="#" class="relative text-gray-700 hover:text-red-600">
                        <i class="fas fa-shopping-basket text-xl"></i>
                        <span class="absolute -top-2 -right-2 bg-red-600 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">0</span>
                    </a>
                </div>
            </div>
        </header>

        <!-- NỘI DUNG CHÍNH CỦA TỪNG TRANG SẼ ĐƯỢC CHÈN VÀO ĐÂY -->
        <main id="main" class="flex-grow">
            @RenderBody()
        </main>

        <!-- FOOTER TĨNH -->
        <footer id="footer" class="bg-black text-white py-8 mt-auto">
            <!-- Bạn copy toàn bộ thẻ <footer> từ dòng 801 đến 851 trong file PHP cũ dán vào đây -->
            <div class="container mx-auto px-4 text-center">
                <h3 class="text-2xl font-bold mb-4">Boost your power</h3>
                <p class="text-gray-400">©2025 CÔNG TY CỔ PHẦN NVB PLAY</p>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>